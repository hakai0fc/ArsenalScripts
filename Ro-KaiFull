local HealthConnection 
function AutoHealth()
    if HealthConnection then HealthConnection:Disconnect() end 
    HealthConnection = RunService.Heartbeat:Connect(function()
        if not _G.AutoHealth then return end
        local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Equipment")
        local args = {"Workout", {Name = "PushUp"}}
        task.spawn(function() BurstFarm(remote, args, 71, 0.00000000000000000000000001) end)
        task.spawn(function() BurstFarm(remote, args, 71, 0.00000000000000000000000001) end) 
        task.spawn(function() BurstFarm(remote, args, 71, 0.00000000000000000000000001) end)
        task.spawn(function() BurstFarm(remote, args, 71, 0.00000000000000000000000001) end)
        task.spawn(function() BurstFarm(remote, args, 71, 0.00000000000000000000000001) end)
        if getgenv().Kevin and getgenv().Kevin == true then
            task.spawn(function()
                while getgenv().Kevin do
                    if not getgenv().Kevin then break end
                    local success, err = pcall(function()
                        local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Equipment")
                        local args = {"Workout", {Name = "PushUp"}}
                        remote:FireServer(unpack(args))
                        remote:FireServer(unpack(args))
                        remote:FireServer(unpack(args))
                        remote:FireServer(unpack(args))
                        remote:FireServer(unpack(args))
                    end)
                    if not success then warn("Erro no loop Kevin (Health): " .. err) end
                    task.wait(_G.FarmDelay)
                end
            end)
        end
    end)
end

